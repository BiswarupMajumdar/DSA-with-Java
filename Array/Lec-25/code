class Solution {
    public int smallestDivisor(int[] nums, int threshold) {
        //same pattern koko eating bananas
        int start=1 ;
        int end=findMaxofNums(nums);

        int ans=-1;

        while(start<=end){
            int mid = start+(end-start)/2;

            if(isDivisionPossible(nums,mid, threshold)){
                ans=mid;
                end=mid-1; // look for smaller divisor
            }
            else{
                start=mid+1;
            }
        }

        return ans;
    }
    public static int findMaxofNums(int[] nums){
        int max=Integer.MIN_VALUE;
        for(int num:nums){
            if(num>max){
                max=num;
            }
        }
        return max;
    }
    public static boolean isDivisionPossible(int[] nums, int mid, int threshold){
        int sum=0;
        for(int i=0; i<nums.length; i++){
            sum+=(nums[i]+mid-1)/mid; // ceil value
            if(sum>threshold){
                return false;
            }
        }
        return true;
    }
}
